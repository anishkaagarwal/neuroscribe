# NeuroscribeAI Configuration
# Copy this file to `.env` and fill in your own credentials.
# NEVER commit the real `.env` file (it is git-ignored).

# Groq API key (LLM summarization + Whisper ASR) -> https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# Deepgram API key (speaker diarization + intent detection) -> https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_key_here

# Optional: password for the encrypted local feature vault.
# Leave blank to use a randomly generated machine-local key.
LFV_PASSWORD=

# Optional: enable/disable the encrypted feature cache ("true" / "false").
ENABLE_LFV_CACHE=true

# Optional: override where recordings/transcripts are read from and written to.
# Defaults to the `recordings/` folder next to the code.
# NEUROSCRIBE_RECORDINGS_DIR=

# Optional: Chrome user-data profile for the meeting recorder (logged-in session).
# Leave blank to launch a fresh temporary Chrome profile.
# CHROME_PROFILE_PATH=
